# Copy to .env.local and fill in real values. Do not commit secrets.

NEXT_PUBLIC_APP_URL=

# X OAuth 2.0 (Authorization Code + PKCE). Never expose the secret to the browser.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Supabase. Secret key is server-only. Either name works; SUPABASE_SECRET_KEY is preferred.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard. ADMIN_SECRET signs the admin cookie. Do not ship a real secret here.
ADMIN_EMAIL=
ADMIN_SECRET=

# Official targets. Leave X_PINNED_POST_URL empty until the real pinned post exists.
X_OFFICIAL_USERNAME=VeyroHood
X_PINNED_POST_URL=

DISCORD_INVITE_URL=https://discord.gg/ZKWGaxafe

# Optional. Required only if you want live Discord membership checks.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional session pepper. Falls back to ADMIN_SECRET if empty.
SESSION_SECRET=
